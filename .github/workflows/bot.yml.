name: ZYGO Tender Bot
on:
  schedule:
    - cron: "0 4 * * *"
  workflow_dispatch:
    inputs:
      days:
        default: "7"
jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python zygo_tender_bot.py --days ${{ github.event.inputs.days || '1' }}
        env:
          GMAIL_USER: ${{ secrets.GMAIL_USER }}
          GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
          COMPANY_NAME: ZYGO
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: tender-output
          path: tender_output
